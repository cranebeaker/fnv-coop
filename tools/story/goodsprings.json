    "doc": {
      "name": "Doc Mitchell",
      "ref": "$doc",
      "topics": [
        {
          "info": "FalloutNV.esm:1057E7",
          "text": "<Doc Outro> You should talk to Sunny Smiles before you leave town (goodbye; its end script raises the casual / hardcore box and starts the timer that sets stage 200)."
        },
        {
          "info": "FalloutNV.esm:15E139",
          "text": "Don't mention it. It's what I'm here for. (then 1057E7)"
        },
        {
          "info": "FalloutNV.esm:15E13C",
          "text": "Didn't have much choice, I'm afraid. But I understand the sentiment. (then 1057E7)"
        }
      ]
    },
    "sunny": {
      "name": "Sunny Smiles",
      "ref": "$sunny",
      "topics": [
        {
          "info": "FalloutNV.esm:10A1E4",
          "text": "Doc Mitchell said you could teach me to survive in the desert.",
          "sets": [
            "VCG02",
            10
          ],
          "needs": {
            "VCG02": 5
          }
        },
        {
          "info": "FalloutNV.esm:10A1E5",
          "text": "Okay, I'm in.",
          "sets": [
            "VCG02",
            25
          ],
          "needs": {
            "VCG02": 20
          }
        },
        {
          "info": "FalloutNV.esm:15D97E",
          "text": "Couldn't hurt. (the campfire lesson)",
          "sets": [
            "VCG03",
            10
          ],
          "needs": {
            "VCG02": 50
          }
