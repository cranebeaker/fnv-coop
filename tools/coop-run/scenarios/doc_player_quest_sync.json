{
  "name": "doc_player_quest_sync",
  "description": "Host sets VCG01 (Doc Mitchell's intro quest, per player in the policy) to stage 10. It is the host player's own row: it shows under player_quests.host on both peers (mirrored through the shadow blob) and never enters the shared hash, which still has to match.",
  "cell": "GSDocMitchellHouse",
  "network": "perfect",
  "seed": 12,
  "duration_s": 12,
  "settle_s": 4,
  "timeout_s": 240,
  "host": {
    "script": [
      {
        "stage": "VCG01 10"
      }
    ]
  },
  "guest": {
    "script": []
  },
  "expect": [
    {
      "id": "player-stage",
      "path": "player_quests.host.VCG01.stage",
      "op": "ge",
      "value": 10,
      "on": "both"
    },
    {
      "id": "player-stage-equal",
      "path": "player_quests.host.VCG01.stage",
      "on": "equal"
    },
    {
      "id": "shared-hash",
      "path": "hash.shared",
      "on": "equal"
    },
    {
      "id": "not-shared-host",
      "path": "quests.VCG01",
      "op": "absent",
      "on": "host"
    },
    {
      "id": "not-shared-guest",
      "path": "quests.VCG01",
      "op": "absent",
      "on": "guest"
    }
  ]
}
