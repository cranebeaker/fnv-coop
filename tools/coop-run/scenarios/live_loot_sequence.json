{
  "name": "live_loot_sequence",
  "description": "Corrected live_loot_race for the lease design (one holder at a time). The host adds 50 caps to Doc, opens him at 6 s, takes 20 and closes at 10 s; the guest opens at 11 s and takes 25 (less than the 30 left whatever Doc's own starting caps are, which differ between data sets). Host + guest hold 45 together, nothing is lost or doubled, and Doc's remaining caps and each inventory are the same on both peers (the remainder is not asserted as a number).",
  "cell": "GSDocMitchellHouse",
  "network": "good_wifi",
  "seed": 54,
  "duration_s": 24,
  "settle_s": 6,
  "host": {
    "script": [
      {
        "at": 2,
        "run": "DocMitchellREF.AddItem Caps001 50"
      },
      {
        "at": 6,
        "run": "coop lootopen DocMitchellREF"
      },
      {
        "at": 7,
        "run": "coop loottake DocMitchellREF Caps001 20"
      },
      {
        "at": 10,
        "run": "coop lootclose DocMitchellREF"
      }
    ]
  },
  "guest": {
    "script": [
      {
        "at": 11,
        "run": "coop lootopen DocMitchellREF"
      },
      {
        "at": 12,
        "run": "coop loottake DocMitchellREF Caps001 25"
      },
      {
        "at": 15,
        "run": "coop lootclose DocMitchellREF"
      }
    ]
  },
  "expect": [
    {
      "id": "container-same",
      "path": "items.DocMitchellREF.Caps001",
      "on": "equal"
    },
    {
      "id": "conserved",
      "path": "items.host.Caps001",
      "op": "sum",
      "add": [
        "items.guest.Caps001"
      ],
      "cmp": "eq",
      "value": 45,
      "on": "both"
    },
    {
      "id": "host-took-20",
      "path": "items.host.Caps001",
      "op": "eq",
      "value": 20,
      "on": "both"
    },
    {
      "id": "guest-got-25",
      "path": "items.guest.Caps001",
      "op": "eq",
      "value": 25,
      "on": "both"
    },
    {
      "id": "host-items-equal",
      "path": "items.host",
      "on": "equal"
    },
    {
      "id": "guest-items-equal",
      "path": "items.guest",
      "on": "equal"
    },
    {
      "id": "shared-hash",
      "path": "hash.shared",
      "on": "equal"
    }
  ]
}
