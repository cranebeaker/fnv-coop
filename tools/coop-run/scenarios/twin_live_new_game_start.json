  "expect": [
    {"id": "guest-playing", "path": "start.phase", "op": "eq", "value": "playing", "on": "guest"},
    {"id": "guest-venue", "path": "start.venue", "op": "eq", "value": "host_place", "on": "guest"},
    {"id": "host-in-opening", "path": "start.phase", "op": "eq", "value": "character_creation", "on": "host"},
    {"id": "guest-vcg00", "path": "player_quests.guest.VCG00.stage", "op": "ge", "value": 100, "on": "both"},
    {"id": "guest-vcg01", "path": "player_quests.guest.VCG01.stage", "op": "ge", "value": 105, "on": "both"},
    {"id": "host-vcg01-moves", "path": "player_quests.host.VCG01.stage", "op": "ge", "value": 5, "on": "both"},
    {"id": "host-vcg01-equal", "path": "player_quests.host.VCG01.stage", "on": "equal"},
    {"id": "not-shared-host", "path": "quests.VCG01", "op": "absent", "on": "host"},
    {"id": "not-shared-guest", "path": "quests.VCG01", "op": "absent", "on": "guest"},
    {"id": "shared-hash", "path": "hash.shared", "on": "equal"}
  ]
