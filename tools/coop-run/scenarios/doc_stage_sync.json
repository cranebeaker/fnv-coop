  "cell": "GSDocMitchellHouse",
  "network": "perfect",
  "seed": 11,
  "duration_s": 12,
  "settle_s": 4,
  "timeout_s": 240,
  "host": { "script": [ { "stage": "VCG03 10" } ] },
