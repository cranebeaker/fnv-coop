{
  "cell": "GSDocMitchellHouse",
  "network": "good_wifi",
  "seed": 71,
  "duration_s": 10,
  "settle_s": 8,
  "name": "live_control_lock_per_player",
  "description": "A quest whose policy says the control lock belongs to the initiator (the Old World Blues Auto-Doc, a policy row that has the same id in every load order). The guest starts it; the host's script disables the controls. Only the guest is locked.",
  "host": {
    "script": [
      {
        "at": 1,
        "run": "coop initiate NVDLC03AutoDoc 1"
      },
      {
        "at": 2,
        "run": "coop lock 1111111 NVDLC03AutoDoc"
      }
    ]
  },
  "expect": [
    {
      "id": "guest-locked",
      "path": "scene.locks",
      "on": "guest",
      "op": "eq",
      "value": 127
    },
    {
      "id": "guest-controls",
      "path": "scene.controls",
      "on": "guest",
      "op": "eq",
      "value": 127
    },
    {
      "id": "host-free",
      "path": "scene.locks",
      "on": "host",
      "op": "eq",
      "value": 0
    },
    {
      "id": "host-controls",
      "path": "scene.controls",
      "on": "host",
      "op": "eq",
      "value": 0
    },
    {
      "id": "shared-hash",
      "path": "hash.shared",
      "on": "equal"
    }
  ]
}
