{
  "name": "live_reconnect",
  "description": "The link dies for 8 seconds. The host teleports to point A before the outage and to point B (about 400 units away) after it ends; the guest must see the host at B, not stale at A, after it reconnects, and the shared state converges.",
  "cell": "GSDocMitchellHouse",
  "network": "good_wifi",
  "seed": 57,
  "duration_s": 30,
  "settle_s": 8,
  "outages": [
    {
      "at": 8,
      "seconds": 8,
      "dir": "both"
    }
  ],
  "max_repairs": 20,
  "host": {
    "script": [
      {
        "at": 3,
        "run": "coop teleport 2552 1603.6 7360.0"
      },
      {
        "at": 20,
        "run": "coop teleport 2152 1403.6 7360.0"
      }
    ]
  },
  "guest": {
    "script": [
      {
        "at": 3,
        "run": "coop teleport 2152 1803.6 7360.0"
      }
    ]
  },
  "expect": [
    {
      "id": "host-at-B-on-guest",
      "path": "positions.host",
      "op": "near",
      "value": [
        2152,
        1403.6
      ],
      "tol": 80,
      "dims": 2,
      "on": "guest"
    },
    {
      "id": "host-left-A-on-guest",
      "path": "positions.host",
      "op": "dist_from",
      "from": [
        2552,
        1603.6
      ],
      "cmp": "ge",
      "value": 200,
      "on": "guest"
    },
    {
      "id": "host-moved-own",
      "path": "positions.host",
      "op": "dist_from",
      "from": [
        2352.0,
        1603.6,
        7360.0
      ],
      "cmp": "ge",
      "value": 150,
      "on": "host"
    },
    {
      "id": "guest-moved-own",
      "path": "positions.guest",
      "op": "dist_from",
      "from": [
        2352.0,
        1603.6,
        7360.0
      ],
      "cmp": "ge",
      "value": 150,
      "on": "guest"
    },
    {
      "id": "guest-seen-by-host",
      "path": "positions.guest",
      "op": "dist_from",
      "from": [
        2352.0,
        1603.6,
        7360.0
      ],
      "cmp": "ge",
      "value": 150,
      "on": "host"
    },
    {
      "id": "host-equal",
      "path": "positions.host",
      "on": "equal",
      "tol": 40,
      "dims": 2
    },
    {
      "id": "shared-hash",
      "path": "hash.shared",
      "on": "equal"
    }
  ]
}
