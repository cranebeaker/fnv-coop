{
  "name": "live_tether_exterior",
  "description": "The host starts a story tether at a placed object in the Goodsprings exterior (cell 000DAEBB, anchor 0016A527 at -70429, 2208). Both peers start in the exterior cell in its worldspace, as the viewer does, so the live layer files both players under the worldspace. The zone is a disc of 4096 units around the anchor. The host stands 2871 units from the anchor, inside the zone, so the tether counts it inside and it stays. The guest stands 6000 units from the anchor, outside the zone, so the tether warps it to the anchor after the 120 s straggler timeout.",
  "cell": "000DAEBB",
  "network": "good_wifi",
  "seed": 57,
  "duration_s": 140,
  "settle_s": 8,
  "timeout_s": 400,
  "host": {
    "script": [
      {
        "at": 1,
        "run": "coop teleport -73300.0 2208.0 8367.0"
      },
      {
        "at": 4,
        "run": "coop tether 0016A527"
      }
    ]
  },
  "guest": {
    "script": [
      {
        "at": 2,
        "run": "coop teleport -76429.0 2208.0 8367.0"
      }
    ]
  },
  "expect": [
    {
      "id": "host-counted-inside",
      "path": "live.tether_zone.host",
      "op": "eq",
      "value": true,
      "on": "host"
    },
    {
      "id": "guest-inside-after-warp",
      "path": "live.tether_zone.guest",
      "op": "eq",
      "value": true,
      "on": "host"
    },
    {
      "id": "inside-stays",
      "path": "positions.host",
      "op": "dist_from",
      "from": [
        -73300.0,
        2208.0
      ],
      "cmp": "le",
      "value": 50,
      "on": "both"
    },
    {
      "id": "outside-warped",
      "path": "positions.guest",
      "op": "dist_from",
      "from": [
        -70429.0,
        2208.0
      ],
      "cmp": "le",
      "value": 1500,
      "on": "both"
    },
    {
      "id": "positions-equal",
      "path": "positions.guest",
      "on": "equal",
      "tol": 600,
      "dims": 2
    },
    {
      "id": "shared-hash",
      "path": "hash.shared",
      "on": "equal"
    }
  ]
}
