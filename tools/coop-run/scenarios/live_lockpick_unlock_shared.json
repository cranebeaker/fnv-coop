{
  "name": "live_lockpick_unlock_shared",
  "description": "The host locks Doc Mitchell's front door (level 2). The guest plays the lockpicking game (the bot reports a win) and the host unlocks it for everyone: the lock reads unlocked (-1) on both peers.",
  "cell": "GSDocMitchellHouse",
  "network": "good_wifi",
  "seed": 64,
  "duration_s": 26,
  "settle_s": 6,
  "host": {
    "script": [
      {
        "at": 2,
        "run": "coop setlock GSDocMitchellHouseIntDoorREF 2"
      }
    ]
  },
  "guest": {
    "script": [
      {
        "at": 10,
        "run": "coop lockpick GSDocMitchellHouseIntDoorREF won 2"
      }
    ]
  },
  "expect": [
    {
      "id": "unlocked-host",
      "path": "objects.locks.GSDocMitchellHouseIntDoorREF",
      "op": "eq",
      "value": -1,
      "on": "host"
    },
    {
      "id": "unlocked-guest",
      "path": "objects.locks.GSDocMitchellHouseIntDoorREF",
      "op": "eq",
      "value": -1,
      "on": "guest"
    },
    {
      "id": "counted",
      "path": "interact.lockpick",
      "op": "ge",
      "value": 1,
      "on": "guest"
    },
    {
      "id": "shared-hash",
      "path": "hash.shared",
      "on": "equal"
    }
  ]
}
