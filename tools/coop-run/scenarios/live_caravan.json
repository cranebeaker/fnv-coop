{
    "name": "live_caravan",
    "description": "The entry fee (the stake) of a caravan game is paid once per player. The host has 40 caps, the guest 50. The guest loses a game of 20 caps to Doc Mitchell (coop caravan: the act the guest's caravan menu sends when a game ends, run on the host in the guest's shadow by progress::caravan_played and caravan::bet::settle). The guest pays 20 caps once, on both peers, and Doc gets them once (4 of his own plus 20). Only the guest's record shows the loss. The host keeps its 40 caps and a clean record. The host's script first sets Doc's caps to 4, because the real game and the headless start Doc with different caps.",
    "cell": "GSDocMitchellHouse",
    "network": "good_wifi",
    "seed": 82,
    "duration_s": 16,
    "settle_s": 4,
    "host": {
        "script": [
            {
                "at": 1,
                "run": "DocMitchellREF.RemoveItem Caps001 1000"
            },
            {
                "at": 1.5,
                "run": "DocMitchellREF.AddItem Caps001 4"
            },
            {
                "at": 1,
                "run": "player.AddItem Caps001 40"
            },
            {
                "at": 1.5,
                "run": "coop give 1 Caps001 50"
            }
        ]
    },
    "guest": {
        "script": [
            {
                "at": 6,
                "run": "coop caravan DocMitchellREF 20 lost"
            }
        ]
    },
    "expect": [
        {
            "id": "guest-paid-once",
            "path": "items.guest.Caps001",
            "op": "eq",
            "value": 30,
            "on": "both"
        },
        {
            "id": "party-paid-once",
            "path": "items.guest.Caps001",
            "op": "sum",
            "add": [
                "items.host.Caps001"
            ],
            "cmp": "eq",
            "value": 70,
            "on": "both"
        },
        {
            "id": "doc-paid-once",
            "path": "items.DocMitchellREF.Caps001",
            "op": "eq",
            "value": 24,
            "on": "both"
        },
        {
            "id": "guest-record",
            "path": "campaign.caravan.guest.cap_losses",
            "op": "eq",
            "value": 20,
            "on": "host"
        },
        {
            "id": "guest-one-loss",
            "path": "campaign.caravan.guest.losses",
            "op": "eq",
            "value": 1,
            "on": "host"
        },
        {
            "id": "records-per-player",
            "path": "campaign.caravan.guest.losses",
            "op": "sum",
            "add": [
                "campaign.caravan.host.losses"
            ],
            "cmp": "eq",
            "value": 1,
            "on": "host"
        }
    ]
}
