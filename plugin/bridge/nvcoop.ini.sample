; Data\NVSE\Plugins\nvcoop.ini  (all keys optional; env vars NVCOOP_INSTANCE / NVCOOP_AUTOLOAD /
; NVCOOP_AUTOLOAD_FRAMES override the ini)
[bridge]
; pipe will be \.\pipe\nvcoop-<instance>
instance=0
; save name WITHOUT extension, loaded automatically once the main menu is up; empty = off
autoload=
; frames to wait after the main menu is ready before loading
autoloadDelayFrames=600

[rules]
; Party tether: keeps the players together inside a scene zone (35 quest rules). on = hold the stage and auto-warp a far player (default),
; warn = never hold or warp, only tell a far player they are outside the scene zone, off = ignore the tether rules.
tether=on
; Death and late join in story scenes (docs/quest-policies/wave1-kinds.md): death.mode = downed | respawn | normal; death.revive_s = 60;
; death.all_down = reload-host-save | respawn; late_join.during_scene = wait | join; late_join.after_scene = warp-to-zone | stay. Empty = rules.json decides.
;death.mode=downed

[live]
; The enemy / NPC / avatar sync. Every switch is OFF by default (nothing of it runs in a game until it has been proven there).
; Environment override for automated runs: NVCOOP_LIVE_ACTORS / NVCOOP_LIVE_AVATARS / NVCOOP_LIVE_COMBAT / NVCOOP_LIVE_SPAWNS / NVCOOP_LIVE_SOCIAL = 1.
; NPC ownership: one machine runs each NPC's AI, the others show a smooth copy (plugin/actors, the real engine port)
actors=0
; player puppets: a restrained actor per remote player, driven from the player's snapshots (plugin/avatar)
avatars=0
; hits, deaths, projectiles: a hit is resolved once, by the machine that owns the victim (needs actors=1)
combat=0
; spawn-site arbitration: one owner per spawn site, shared net ids (needs actors=1)
spawns=0
; companions / crime / kill rewards: the avatar puppet map for the party rules and a status line (needs actors=1). The module itself is [companions] enabled=1.
social=0

[actors]
; tuning of the real actor port; every value is clamped to a safe range (see plugin/coop/live/live_actors_cfg.h)
; engine=0 keeps the no-op port even with [live] actors=1
engine=1
scanMs=500
maxScanActors=400
maxLinesPerFrame=24
driveMinMs=33

[splitscreen]
; split-screen on one PC (docs/tools/splitscreen.md). tools/splitscreen/launch.py writes this section for every game copy; edit by hand only to experiment.
; enable=0 (default): nothing below is read or patched.
enable=0
; player=0 is player one (the host). players=2..4 copies share the screen.
player=0
players=2
; pad: the physical controller this copy answers to (0..3) or none. Missing = XInput is left alone.
pad=none
; kbm=1: keyboard and mouse drive this copy. The game reads them only while no pad answers, so a copy that must ignore them keeps a ghost pad.
kbm=1
ghostPad=0
; audio: play (player one) or mute (the other copies are muted in the Windows volume mixer)
audio=play
focusFake=1
; devInject=1 registers split.inject (a synthetic controller for tools/splitscreen/smoke_playbook.py). Test only.
devInject=0

; ---- story capture (docs/tools/story-capture.md) ----
[hooks]
; story_capture=1 hooks about 75 more script commands (actor AI orders, spells, equipment, ownership of the cell, chargen and progression calls, challenges ...) on the
; host and records them as RefCommand effects; guests apply them. Default 0: the extra hooks are not installed. Both machines need the same build.
story_capture=0
