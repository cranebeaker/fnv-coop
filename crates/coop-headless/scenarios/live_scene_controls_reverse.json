{
  "name": "live_scene_controls_reverse",
  "description": "Two sources lock the controls at once. The BeatrixFX scene takes every control but the view switch (119). A script's control lock then takes the view switch only (8). The host skips the scene. That ends the scene's lock only: the script's own 8 stays in force on both peers, and the control scene is the one left.",
  "cell": "GSDocMitchellHouse",
  "network": "good_wifi",
  "seed": 88,
  "duration_s": 14,
  "settle_s": 6,
  "host": {
    "script": [
      { "at": 1, "run": "coop cinematic 1554961" },
      { "at": 3, "run": "coop lock 0001000" },
      { "at": 7, "run": "coop skip yes" }
    ]
  },
  "guest": { "script": [] },
  "expect": [
    { "id": "scene-locks-host", "path": "scene.locks", "op": "eq", "value": 8, "on": "host" },
