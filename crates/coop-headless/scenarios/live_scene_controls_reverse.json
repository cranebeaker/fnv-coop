    { "id": "guest-controls", "path": "scene.controls", "op": "eq", "value": 8, "on": "guest" },
    { "id": "one-left", "path": "scene.active", "op": "eq", "value": 1, "on": "both" },
    { "id": "control-left", "path": "scene.kind", "op": "eq", "value": 1, "on": "both" },
    { "id": "scene-skipped", "path": "scene.last_reason", "op": "eq", "value": 2, "on": "both" },
    { "id": "same-scene", "path": "scene.id", "on": "equal" },
    { "id": "shared-hash", "path": "hash.shared", "on": "equal" }
  ]
