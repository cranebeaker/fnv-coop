{
  "name": "live_two_cells_actor_owner",
  "description": "Host stays in the test cell, the guest walks into another cell. The host owns the cell's actors; the guest owns and mirrors none and the host learns the guest's cell. Headless only: runs on the generated test data (cell TestFightCell) and uses the `coop cell` bot verb, which the viewer bot does not have.",
  "cell": "TestFightCell",
  "network": "good_wifi",
  "seed": 70,
  "duration_s": 14,
  "settle_s": 4,
  "host": {
    "script": []
  },
  "guest": {
    "script": [
      {
        "at": 1,
        "run": "coop cell D00001"
      }
    ]
  },
  "expect": [
    {
      "id": "host-owns",
      "path": "live.roam.owned.host",
      "op": "ge",
      "value": 1,
      "on": "host"
    },
    {
      "id": "guest-owns-none",
      "path": "live.roam.owned.guest",
      "op": "eq",
      "value": 0,
      "on": "guest"
    },
    {
      "id": "guest-mirrors-none",
      "path": "live.roam.remote_actors",
      "op": "eq",
      "value": 0,
      "on": "guest"
    },
    {
      "id": "host-knows-guest-cell",
      "path": "live.roam.cells.guest",
      "op": "eq",
      "value": 13631489,
      "on": "host"
    },
    {
      "id": "shared-hash",
      "path": "hash.shared",
      "on": "equal"
    }
  ]
}
