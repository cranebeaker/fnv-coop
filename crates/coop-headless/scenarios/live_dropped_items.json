{
  "name": "live_dropped_items",
  "description": "The host drops 2 of its 3 stimpaks into the world (the host mints the reference FD000001). The host and the guest both try to pick the pile up at the same moment. First claim wins: the 3 stimpaks exist once between the two players, the losing claim is refused, and the dropped reference is gone on both peers.",
  "cell": "GSDocMitchellHouse",
  "network": "good_wifi",
  "seed": 93,
  "duration_s": 22,
  "settle_s": 6,
  "host": {
    "script": [
      {
        "at": 2,
        "run": "coop give 0 Stimpak 3"
      },
      {
        "at": 4,
        "run": "coop drop Stimpak 2"
      },
      {
        "at": 10,
        "run": "coop pickup FD000001 Stimpak 2"
      }
    ]
  },
  "guest": {
    "script": [
      {
        "at": 10,
        "run": "coop pickup FD000001 Stimpak 2"
      }
    ]
  },
  "expect": [
    {
      "id": "one-owner-host",
      "path": "items.host.Stimpak",
      "op": "sum",
      "add": [
        "items.guest.Stimpak"
      ],
      "cmp": "eq",
      "value": 3,
      "on": "host"
    },
    {
      "id": "one-owner-guest",
      "path": "items.host.Stimpak",
      "op": "sum",
      "add": [
        "items.guest.Stimpak"
      ],
      "cmp": "eq",
      "value": 3,
      "on": "guest"
    },
    {
      "id": "claim-refused",
      "path": "interact.refused",
      "op": "ge",
      "value": 1,
      "on": "guest"
    },
    {
      "id": "gone-host",
      "path": "disabled.FD000001",
      "op": "present",
      "on": "host"
    },
    {
      "id": "gone-guest",
      "path": "disabled.FD000001",
      "op": "present",
      "on": "guest"
    },
    {
      "id": "host-items-equal",
      "path": "items.host",
      "on": "equal"
    },
    {
      "id": "guest-items-equal",
      "path": "items.guest",
      "on": "equal"
    },
    {
      "id": "shared-hash",
      "path": "hash.shared",
      "on": "equal"
    }
  ]
}