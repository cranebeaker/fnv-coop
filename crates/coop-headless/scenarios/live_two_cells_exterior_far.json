{
  "name": "live_two_cells_exterior_far",
  "description": "Two peers far apart in the same worldspace. Both start in Doc Mitchell's house. The host leads the party out into Goodsprings (WastelandNV). The guest moves about 32000 units east (about 8 grid cells, beyond the 2-cell load radius) with `coop teleport`. Each peer must own and run the people of its own cell, the host must count the guest's people as the guest's, and neither peer may mirror the other cell's people. After the split the host sets CG03TestValue and the guest asks the host to set DemoVatsCameraGlobal: both values must reach both peers, and the shared hash must agree. A `coop hit NAME 1` line hits that person once for 1 point. The line also names the person, so the simulator loads it (the viewer loads the whole cell). Headless only: the viewer bot has no `coop cell` verb. Each peer loads the grid square around its own player: the host's view of both grids and the guest's own grid must show two separate 5x5 squares (grid x -18 and -11).",
  "cell": "GSDocMitchellHouse",
  "network": "good_wifi",
  "seed": 73,
  "duration_s": 18,
  "settle_s": 5,
  "host": {
    "script": [
      {
        "at": 2,
        "run": "coop enter GSDocMitchellHouseIntDoorREF GSDocMitchellHouse 00000001"
      },
      {
        "at": 7,
        "run": "coop hit vGSBrahmin02Ref 1"
      },
      {
        "at": 8,
        "run": "set CG03TestValue to 7"
      }
    ]
  },
  "guest": {
    "script": [
      {
        "at": 5,
        "run": "coop teleport -41361 -10871 6018"
      },
      {
        "at": 6,
        "run": "coop hit VERT1GSCaravanAmbush01DudeREF 1"
      },
      {
        "at": 10,
        "run": "set DemoVatsCameraGlobal to 1"
      }
    ]
  },
  "expect": [
    {
      "id": "host-runs-its-cell",
      "path": "actors.vGSBrahmin02Ref.owner",
      "op": "eq",
      "value": "me",
      "on": "host"
    },
    {
      "id": "guest-runs-its-cell",
      "path": "actors.VERT1GSCaravanAmbush01DudeREF.owner",
      "op": "eq",
      "value": "me",
      "on": "guest"
    },
    {
      "id": "host-counts-guest-owned",
      "path": "live.roam.owned.guest",
      "op": "eq",
      "value": 1,
      "on": "host"
    },
    {
      "id": "guest-mirrors-none",
      "path": "live.roam.remote_actors",
      "op": "eq",
      "value": 0,
      "on": "guest"
    },
    {
      "id": "host-mirrors-none",
      "path": "live.roam.remote_actors",
      "op": "eq",
      "value": 0,
      "on": "host"
    },
    {
      "id": "host-change-reached-both",
      "path": "globals.CG03TestValue",
      "op": "eq",
      "value": 7,
      "on": "both"
    },
    {
      "id": "guest-change-reached-both",
      "path": "globals.DemoVatsCameraGlobal",
      "op": "eq",
      "value": 1,
      "on": "both"
    },
    {
      "id": "host-loads-its-grid",
      "path": "live.roam.grids.host.x",
      "op": "eq",
      "value": -18,
      "on": "host"
    },
    {
      "id": "host-grid-full",
      "path": "live.roam.grids.host.cells",
      "op": "eq",
      "value": 25,
      "on": "host"
    },
    {
      "id": "guest-loads-its-grid",
      "path": "live.roam.grids.guest.x",
      "op": "eq",
      "value": -11,
      "on": "both"
    },
    {
      "id": "guest-grid-full",
      "path": "live.roam.grids.guest.cells",
      "op": "eq",
      "value": 25,
      "on": "both"
    },
    {
      "id": "shared-hash",
      "path": "hash.shared",
      "on": "equal"
    }
  ]
}
