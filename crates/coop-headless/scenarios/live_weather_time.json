{
  "name": "live_weather_time",
  "description": "The host asks to wait 3 hours and the guest agrees. The hours pass once, on the host, and both peers end on the same clock. The host's script then forces NVWastelandHazy (00100A4E, 1051214). The guest rolls no weather of its own: its sky shows the host's weather.",
  "cell": "GSDocMitchellHouse",
  "network": "good_wifi",
  "seed": 91,
  "duration_s": 14,
  "settle_s": 8,
  "host": {
    "script": [
      { "at": 3, "run": "coop wait 3" },
      { "at": 9, "run": "ForceWeather NVWastelandHazy 1" }
    ]
  },
  "guest": {
    "script": [
      { "at": 4, "run": "coop vote yes" },
      { "at": 5, "run": "coop vote yes" },
      { "at": 6, "run": "coop vote yes" }
    ]
  },
  "expect": [
    { "id": "skips-host", "path": "time.skips", "op": "eq", "value": 1, "on": "host" },
    { "id": "skips-guest", "path": "time.skips", "op": "eq", "value": 1, "on": "guest" },
    { "id": "hours-host", "path": "time.hours", "op": "eq", "value": 3, "on": "host" },
    { "id": "hours-guest", "path": "time.hours", "op": "eq", "value": 3, "on": "guest" },
    { "id": "clock", "path": "globals.GameHour", "on": "equal", "tol": 0.4 },
    { "id": "days", "path": "globals.GameDaysPassed", "on": "equal", "tol": 0.05 },
    { "id": "weather-host", "path": "live.weather", "op": "eq", "value": 1051214, "on": "host" },
    { "id": "weather-guest", "path": "live.weather", "op": "eq", "value": 1051214, "on": "guest" },
    { "id": "shared-hash", "path": "hash.shared", "on": "equal" }
  ]
}
