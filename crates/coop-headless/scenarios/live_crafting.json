    { "id": "guest-spent-broc", "path": "items.guest.BrocFlower", "op": "absent", "on": "both" },
    { "id": "guest-spent-xander", "path": "items.guest.XanderRoot", "op": "absent", "on": "both" },
    { "id": "host-kept-broc", "path": "items.host.BrocFlower", "op": "eq", "value": 2, "on": "both" },
    { "id": "host-kept-xander", "path": "items.host.XanderRoot", "op": "eq", "value": 2, "on": "both" },
    { "id": "host-made-nothing", "path": "items.host.NVHealingPowder", "op": "absent", "on": "both" },
    { "id": "counted", "path": "interact.craft", "op": "ge", "value": 1, "on": "guest" },
    { "id": "shared-hash", "path": "hash.shared", "on": "equal" }
