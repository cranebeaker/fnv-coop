  "host": {
    "script": [
      { "at": 1, "run": "coop give 0 BrocFlower 2" },
      { "at": 1, "run": "coop give 0 XanderRoot 2" },
      { "at": 1, "run": "coop give 1 BrocFlower 2" },
      { "at": 1, "run": "coop give 1 XanderRoot 2" }
