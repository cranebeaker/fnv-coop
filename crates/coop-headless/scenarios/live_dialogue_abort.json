{
  "name": "live_dialogue_abort",
  "description": "The guest opens a conversation with Doc Mitchell and walks away without a pick (the menu closes). The session must end cleanly: Doc is free again, so the host can talk to him, pick a line, and both peers play it.",
  "cell": "GSDocMitchellHouse",
  "network": "good_wifi",
  "seed": 82,
  "duration_s": 22,
  "settle_s": 6,
  "host": {
    "script": [
      { "at": 10, "run": "coop talk DocMitchellREF" },
      { "at": 13, "run": "coop pick 00107220" },
      { "at": 16, "run": "coop linedone" },
      { "at": 19, "run": "coop close" }
    ]
  },
  "guest": {
    "script": [
      { "at": 3, "run": "coop talk DocMitchellREF" },
      { "at": 6, "run": "coop close" }
    ]
  },
  "expect": [
    { "id": "host-line-played", "path": "live.lines_played", "op": "ge", "value": 1, "on": "host" },
    { "id": "guest-saw-line", "path": "live.lines_played", "op": "ge", "value": 1, "on": "guest" },
    { "id": "lines-equal", "path": "live.lines_played", "on": "equal" },
    { "id": "shared-hash", "path": "hash.shared", "on": "equal" }
  ]
}
