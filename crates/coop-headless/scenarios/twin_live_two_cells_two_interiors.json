{
  "name": "twin_live_two_cells_two_interiors",
  "description": "MUTATION TWIN of live_two_cells_two_interiors: the guest never leaves the host's cell, so it does not run the other cell's person and it mirrors the host's people. Marked expect_fail.",
  "cell": "GSDocMitchellHouse",
  "network": "good_wifi",
  "seed": 73,
  "duration_s": 18,
