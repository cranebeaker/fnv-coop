    {"id": "host-counts-guest-owned", "path": "live.roam.owned.guest", "op": "eq", "value": 1, "on": "host"},
    {"id": "guest-mirrors-none", "path": "live.roam.remote_actors", "op": "eq", "value": 0, "on": "guest"},
    {"id": "host-mirrors-none", "path": "live.roam.remote_actors", "op": "eq", "value": 0, "on": "host"},
    {"id": "guest-cell-known", "path": "live.roam.cells.guest", "op": "eq", "value": 1073541, "on": "both"},
    {"id": "host-change-reached-both", "path": "globals.CG03TestValue", "op": "eq", "value": 7, "on": "both"},
    {"id": "guest-change-reached-both", "path": "globals.DemoVatsCameraGlobal", "op": "eq", "value": 1, "on": "both"},
