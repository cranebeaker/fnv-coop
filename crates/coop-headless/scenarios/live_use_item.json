    { "id": "host-kept", "path": "items.host.Stimpak", "op": "eq", "value": 3, "on": "both" },
    { "id": "counted", "path": "interact.use", "op": "ge", "value": 1, "on": "guest" },
    { "id": "shared-hash", "path": "hash.shared", "on": "equal" }
  ]
