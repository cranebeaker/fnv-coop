{
  "name": "live_casino",
  "description": "Each player has their own casino ledger. Both players play at the Tops. The guest starts with 100 chips and closes a game with 120 chips and 20 net winnings. The host starts with 50 chips and closes a game with 20 chips and 30 lost. Each close is coop casino: the act the guest's blackjack, roulette or slots menu sends when it closes, run on the host in that player's shadow by progress::casino_closed and casino::settle. Each player's chips and Tops ledger are their own: guest 120 chips and +20, host 20 chips and -30.",
  "cell": "GSDocMitchellHouse",
  "network": "good_wifi",
  "seed": 83,
  "duration_s": 16,
  "settle_s": 4,
  "host": {
    "script": [
      {
        "at": 1,
        "run": "player.AddItem TheTopsChip 50"
      },
      {
        "at": 1.5,
        "run": "coop give 1 TheTopsChip 100"
      },
      {
        "at": 9,
        "run": "coop casino TheTopsCasinoData 20 -30"
      }
    ]
  },
  "guest": {
    "script": [
      {
        "at": 6,
        "run": "coop casino TheTopsCasinoData 120 20"
      }
    ]
  },
  "expect": [
    {
      "id": "guest-chips",
      "path": "items.guest.TheTopsChip",
      "op": "eq",
      "value": 120,
      "on": "both"
    },
    {
      "id": "party-chips",
      "path": "items.guest.TheTopsChip",
      "op": "sum",
      "add": [
        "items.host.TheTopsChip"
      ],
      "cmp": "eq",
      "value": 140,
      "on": "both"
    },
    {
      "id": "guest-ledger",
      "path": "campaign.casino.guest.TheTopsCasinoData",
      "op": "eq",
      "value": 20,
      "on": "host"
    },
    {
      "id": "own-ledgers",
      "path": "campaign.casino.guest.TheTopsCasinoData",
      "op": "sum",
      "add": [
        "campaign.casino.host.TheTopsCasinoData"
      ],
      "cmp": "eq",
      "value": -10,
      "on": "host"
    }
  ]
}
